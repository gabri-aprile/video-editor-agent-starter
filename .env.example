# ===== OBBLIGATORIE =====

# Anthropic — per chiamate dirette all'API Claude dagli script
# Crea la chiave su https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ===== CONSIGLIATE (gratis) =====

# Pixabay — stock footage gratuito
# Registrati su https://pixabay.com/ e apri https://pixabay.com/api/docs/
# La tua chiave è già scritta nella tabella dei parametri, alla voce "key"
PIXABAY_API_KEY=

# Pexels — solo se hai GIÀ una chiave (dal 26 ottobre 2026 Pexels non ne dà di nuove)
PEXELS_API_KEY=

# ===== OPZIONALI (a pagamento) =====

# KIE.ai — Seedance, Kling, Nano Banana per video AI
# https://kie.ai/
KIE_API_KEY=

# ElevenLabs — TTS (se generi la voce dalla pipeline)
# https://elevenlabs.io/
ELEVENLABS_API_KEY=

# HeyGen — avatar (richiede piano enterprise per uso commerciale)
# https://www.heygen.com/
HEYGEN_API_KEY=

# Apify — scraping articoli/social
# https://apify.com/
APIFY_API_TOKEN=

# OpenAI — alternativa a faster-whisper per trascrizione
# https://platform.openai.com/
OPENAI_API_KEY=
